# Only reviewed app source belongs in this repository.
# Raw survey data, PDFs, temporary files and local secrets stay on this computer.
/*
!/.gitignore
!/.vercelignore
!/index.html
!/styles.css
!/app.js
!/sample-data.json
!/build.mjs
!/vercel.json
!/places.js
!/journal.js
!/places-data.json
!/scripts/
/scripts/*
!/scripts/update-places.py
!/scripts/place-selection.json
!/start.ps1
!/README.md
!/assets/
/assets/*
!/assets/jeju-landscape.svg
